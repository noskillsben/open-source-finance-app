{
  "permissions": {
    "allow": [
      "Bash(gh pr merge*--squash*)"
    ],
    "deny": [
      "Bash(gh pr merge*--admin*)",
      "Bash(gh pr merge*--merge*)",
      "Bash(gh pr merge*--rebase*)",
      "Bash(gh pr merge* -m*)",
      "Bash(gh pr merge* -r*)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
