# Copy to .env. The values below are for local development; production values are described at the bottom.

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
# The backend derives DATABASE_URL from the three values above; override only for an external database.
# DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/finance

# single_user (default) or multi_user (not built yet)
APP_MODE=single_user

# Where the pre-migration dumps go inside the backend container (bind-mounted to ./backups)
BACKUP_DIR=/backups

# --- Production (docker-compose.prod.yml) ---
# Compose refuses to start the prod stack unless the three POSTGRES_ values are set in .env.
# Use a long random password with letters and digits only (it is embedded in the database URL).
# POSTGRES_PASSWORD=<generate one>
# Host port the web container publishes (default 80). The only published port.
# WEB_PORT=80
