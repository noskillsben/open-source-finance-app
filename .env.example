# Copy to .env. Development needs no values here: docker-compose.yml defaults the three POSTGRES_ values to "finance".
# Production needs all three set (see the Production block at the bottom).

# POSTGRES_USER=finance
# POSTGRES_PASSWORD=finance
# POSTGRES_DB=finance
# The backend derives DATABASE_URL from the three values above; override only for an external database.
# DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/finance

# single_user (default) or multi_user (not built yet)
APP_MODE=single_user

# Where the pre-migration dumps go inside the backend container (bind-mounted to ./backups)
BACKUP_DIR=/backups

# --- Production (docker-compose.prod.yml) ---
# Compose refuses to start the prod stack unless POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB are all set in .env
# (uncomment and fill in the three lines at the top). Use a generated password, long and random, letters and digits only
# (it is embedded in the database URL), never "finance". The prod database lives in its own volume, finance-prod-pgdata.
# POSTGRES_PASSWORD=<generate one>
# Host port the web container publishes (default 80). The only published port.
# WEB_PORT=80
