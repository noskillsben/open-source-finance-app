# Copy to .env. Everything here has a working default for local development.

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
# The backend derives DATABASE_URL from the three values above; override only for an external database.
# DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/finance

# single_user (default) or multi_user (not built yet)
APP_MODE=single_user

# Where the pre-migration dumps go inside the backend container (bind-mounted to ./backups)
BACKUP_DIR=/backups
